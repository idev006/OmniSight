# OmniSight RTSP Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Run: python rtsp_agent.py

# ── Required ─────────────────────────────────────────────────────────────────

# Backend WebSocket base URL (no trailing slash, no /api path)
OMNISIGHT_WS=ws://localhost:8000

# Station UUID — create stations in the OmniSight UI first, then copy the UUID
STATION_ID=your-station-uuid-here

# Camera UUID — register the camera in Cameras UI (Admin → Cameras → Add),
# then copy the UUID. This ensures Pilot Console shows the correct camera name.
CAMERA_ID=your-camera-uuid-here

# JWT access token — log in via API or browser, copy from localStorage key "omnisight-token"
# The token holder needs OPERATOR or ADMIN role and must have access to the station.
# Re-generate when expired (default expiry: 8 hours, configurable in Settings).
OMNISIGHT_TOKEN=your-jwt-token-here

# RTSP stream URL for your IP camera
# Hikvision:  rtsp://admin:password@192.168.1.64:554/Streaming/Channels/101
# Dahua:      rtsp://admin:password@192.168.1.108:554/cam/realmonitor?channel=1&subtype=0
# Generic:    rtsp://user:pass@192.168.x.x:554/stream1
# VLC test:   rtsp://localhost:8554/test
RTSP_URL=rtsp://user:pass@192.168.1.x:554/stream1

# ── Optional (with defaults) ──────────────────────────────────────────────────

# Frames to SEND per second from this agent (default: 2)
# Backend also gates at max_fps_per_camera (configurable in Settings UI).
# Sending fewer frames saves bandwidth and CPU.
TARGET_FPS=2

# JPEG compression quality 1-100 (default: 70)
# Lower = smaller payload = faster network transfer. 70 is a good balance.
JPEG_QUALITY=70

# Resize frame width before sending (default: 640, set 0 to disable resize)
# The face engine works well at 640px wide. Larger = more detail but more CPU.
RESIZE_WIDTH=640
