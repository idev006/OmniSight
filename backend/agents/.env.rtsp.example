# RTSP Agent — environment variables template
# Copy to .env and fill in real values, or set these in docker-compose.rtsp.yml / .env.prod

# OmniSight backend WebSocket URL (use container name in Docker, localhost when running standalone)
OMNISIGHT_WS=ws://localhost:8000/api/v1/ws/scan/YOUR_STATION_UUID

# Station UUID (from OmniSight Stations page)
STATION_ID=YOUR_STATION_UUID

# Unique ID for this camera (shows in Pilot Console camera list)
CAMERA_ID=rtsp-cam1

# OPERATOR JWT — obtain via:
#   curl -s -X POST http://localhost:8000/api/v1/auth/login \
#        -H "Content-Type: application/json" \
#        -d '{"username":"operator1","password":"YOUR_PASS"}' | python -m json.tool
TOKEN=eyJhbGci...

# RTSP stream URL
# Hikvision example:  rtsp://admin:pass@192.168.1.100:554/Streaming/Channels/101
# Dahua example:      rtsp://admin:pass@192.168.1.101:554/cam/realmonitor?channel=1&subtype=0
# Generic ONVIF:      rtsp://admin:pass@192.168.1.102:554/stream1
RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream1

# Frame rate sent to OmniSight backend (keep ≤ max_fps_per_camera setting)
TARGET_FPS=2

# JPEG compression quality (0–100; lower = smaller payload, faster)
JPEG_QUALITY=70

# Resize longest edge to this width before encoding (0 = no resize)
RESIZE_WIDTH=960
