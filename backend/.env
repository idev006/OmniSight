# OmniSight Backend -- Development Environment
# =============================================
# This file is committed to git intentionally.
# All values below are localhost defaults -- safe for local development only.
# For PRODUCTION: use .env.prod (never commit that file).
#
# After cloning, these values work out-of-the-box with:
#   docker compose up -d   (starts postgres/qdrant/redis on localhost)
#   setup.bat              (full first-time setup)

# -- Database (PostgreSQL) ----------------------------------------------------
# Matches the omnisight service in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://omnisight:omnisight_pass@localhost:5432/omnisight

# -- Vector DB (Qdrant) -------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=face_registry

# -- Cache (Redis) ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- JWT Authentication -------------------------------------------------------
# Change to a strong random key in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# -- Storage ------------------------------------------------------------------
# Path where face snapshot images are saved (relative to backend/)
STORAGE_PATH=../storage/faces

# -- ONNX Runtime Provider ----------------------------------------------------
# Options: cpu | cuda (NVIDIA GPU) | dml (DirectML, Windows GPU)
# Keep "cpu" unless you have a compatible GPU and the correct ONNX packages.
ONNXRUNTIME_PROVIDER=cpu

# -- Face Engine Tuning -------------------------------------------------------
# Minimum liveness/quality score to accept a face (0.0 - 1.0)
MIN_FACE_QUALITY=0.75

# Cosine similarity threshold for recognition (0.0 - 1.0)
# Higher = more strict. 0.72 is well-tested. Adjust only if needed.
MATCH_THRESHOLD=0.72

# Number of enrolled templates required before a person can be recognized
MIN_TEMPLATES_TO_ACTIVATE=6
