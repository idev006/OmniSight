# OmniSight Production Environment Variables
# Copy to .env.prod and fill in real values before deploying.
#
# Usage:
#   cp .env.prod.example .env.prod
#   # Edit .env.prod with real values
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=omnisight
POSTGRES_USER=omnisight
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password_here

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password_here

# ── JWT Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))") ──
SECRET_KEY=CHANGE_ME_64_char_hex_secret_key_here

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_grafana_admin_password_here

# ── Optional overrides ──────────────────────────────────────────────────────
# POSTGRES_DB=omnisight_prod
# QDRANT_COLLECTION=face_registry
